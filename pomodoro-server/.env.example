# 生产部署环境变量示例：复制为 .env 后填写（.env 已在 .gitignore 中，不会被提交）
#   cp .env.example .env
#
# docker-compose.prod.yml 用 `:?` 声明前两项为必需，缺失会直接报错退出。

# 数据库 root 密码
MYSQL_PASSWORD=

# JWT 签名密钥：>= 32 字节的随机串，切勿使用仓库中的默认值（用默认值会拒绝启动）
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 镜像标签，默认 latest；回滚时改成某个具体 sha 标签更稳
IMAGE_TAG=latest

# 未配置则 AI 相关接口自动降级（周报/日报/问答返回结构化数据 + 空文本），不影响主流程
DEEPSEEK_API_KEY=

# 仅当前端部署在**另一个域名**时才需要；H5 与 /api 同域（Nginx 同时提供）时留空即可
# CORS_ALLOWED_ORIGINS=https://pomodoro.example.com